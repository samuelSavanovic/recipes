# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# personal recipe data — the DB is the store of record, raw export stays out of git
/notion_export/

# local dev database (libSQL file fallback when TURSO_* is unset)
/local.db
/local.db-shm
/local.db-wal

# service worker is stamped at build time (prebuild/predev) from sw/sw.js
/public/sw.js

# typescript
*.tsbuildinfo
next-env.d.ts
