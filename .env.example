# Recipe Book — environment variables
# Copy to `.env.local` (gitignored) and fill in. Local dev needs only the last two:
# with TURSO_* unset, lib/db.ts falls back to a local `file:local.db`.

# --- Turso / libSQL (production DB) ---
# Leave both blank for local dev (uses file:local.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Edit gate (required) ---
# The shared password roommate + owner type to unlock editing. Server-verified only.
EDIT_PASSWORD=change-me
# Secret used to sign/verify the long-lived edit token (HMAC). Rotate to revoke all sessions.
SESSION_SECRET=change-me-to-a-long-random-string
